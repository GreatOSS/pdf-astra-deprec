{
  "name": "foliovale",
  "version": "0.1.0",
  "private": true,
  "description": "FolioVale — a calm, local-first PDF viewer and editor",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/GreatOSS/pdf.git" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "fixtures": "tsx tests/fixtures.ts",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": { "pdf-lib": "1.17.1", "pdfjs-dist": "6.3.289" },
  "devDependencies": { "@playwright/test": "^1.58.0", "@types/node": "^24.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0", "vite": "8.3.1" }
}
